  "how_to_compute_full_mapping": {
    "method": "Overlay the Yeo 2011 7-network annotation file on the FreeSurfer DK (aparc) annotation and compute per-region majority vote or overlap percentage.",
    "tools": [
      "FreeSurfer: mri_segstats with annotations on fsaverage surface",
      "AFNI: 3dCM + whereami",
      "PANDA toolbox: between-atlas mapping function",
      "R brainGraph package: contains DK atlas coordinates but NOT Yeo labels (Yeo labels only available for Brainnetome atlas)",
      "Python: nibabel + numpy can read .annot files and compute overlaps"
    ],
