  "behavior_output_model": {
    "description": "B(t) = λ_raw · B_raw + λ_drive · B_drive",
    "natural_mix": { "w_raw": 0.8, "w_drive": 0.2, "description": "情绪主导——身体冲动为主" },
    "forced_mix": { "w_raw": 0.3, "w_drive": 0.7, "description": "意志力覆盖——驱动加工为主" },
    "situational_mix": { "w_raw": 0.5, "w_drive": 0.5, "description": "情境驱动（文化、照护）" },
    "lambda_decay": "λ_raw = exp(-cog_progress), λ_drive = 1 - λ_raw"
  },

