  "metadata": {
    "mapping_strategy": "DK atlas gyrus → modality based on standard functional neuroanatomy. functional_id-level overrides for sub-types where DK granularity is insufficient.",
    "split_criterion": "Two modalities are split into separate columns iff ∃ event needing to activate one without the other (Grilling #34 D7, 2026-08-09).",
    "dk_reference_table": {
      "visual": {
        "pericalcarine": "V1, primary visual — Desikan et al. 2006",
        "cuneus": "Dorsal extrastriate V2/V3 — Glasser et al. 2016",
        "lingual": "Ventral V2/V3, V4 — Glasser et al. 2016",
        "lateraloccipital": "LOC, object recognition — Grill-Spector et al. 2001",
        "fusiform": "FFA/object, ventral stream — Kanwisher et al. 1997",
        "inferiortemporal": "IT, high-level object — Logothetis & Sheinberg 1996",
        "middletemporal": "MT/V5, visual motion — Glasser et al. 2016",
        "superiorparietal": "Dorsal stream, spatial attention — Ungerleider & Mishkin 1982",
        "inferiorparietal": "Angular gyrus, dorsal stream endpoint — Mars et al. 2012"
      },
      "auditory": {
        "transversetemporal": "Heschl's gyrus, A1 — Desikan et al. 2006",
        "superiortemporal": "STG belt/parabelt, voice processing — Belin et al. 2000",
        "middletemporal": "MTG, higher-order auditory — Glasser et al. 2016",
        "bankssts": "STS, voice/speech perception — Desikan et al. 2006"
      },
      "somatosensory": {
        "postcentral": "S1, primary somatosensory — Penfield & Boldrey 1937",
        "paracentral": "Somatosensory leg/foot — Penfield & Boldrey 1937",
        "supramarginal": "S2, secondary somatosensory — Eickhoff et al. 2006"
      },
      "pain": {
        "insula": "Anterior insula, interoceptive/affective pain — Craig 2002",
        "caudalanteriorcingulate": "dACC, affective-motivational pain — Wager et al. 2013",
        "rostralanteriorcingulate": "rACC, pain modulation/regulation — Vogt 2005",
        "postcentral": "S1, sensory-discriminative pain (localization) — Wager et al. 2013",
        "paracentral": "S1 leg, pain localization — shared somatosensory substrate"
      },
      "social_cognition": {
        "superiortemporal": "STS, biological motion, face, theory of mind — Allison et al. 2000",
        "bankssts": "STS, social perception — Desikan et al. 2006",
        "temporalpole": "Social semantic knowledge, person identity — Olson et al. 2007",
        "medialorbitofrontal": "vmPFC, social valuation, moral cognition — Damasio 1994",
        "rostralanteriorcingulate": "rACC, empathy, social pain — Eisenberger et al. 2003",
        "precuneus": "DMN, self-referential, theory of mind — Cavanna & Trimble 2006",
        "superiorfrontal": "mPFC, social cognition, mentalizing — Amodio & Frith 2006",
        "inferiorparietal": "TPJ, theory of mind — Saxe & Kanwisher 2003",
        "supramarginal": "TPJ, empathy, body ownership — Decety & Lamm 2007"
      },
      "language_cognition": {
        "parsopercularis": "Broca's area, language production — Amunts et al. 1999",
        "superiortemporal": "Wernicke's area, language comprehension (via SuperiorTemporalWernicke override)",
        "rostralmiddlefrontal": "DLPFC, verbal working memory — Petrides 2005",
        "frontalpole": "Frontopolar, semantic integration/abstract thought — Koechlin 2016"
      }
    },
    "fid_overrides": {
      "SuperiorTemporalWernicke": {
        "dk_default": [
          "auditory",
          "social_cognition"
        ],
        "override": [
          "auditory",
          "language_cognition"
        ],
        "reason": "Wernicke's area (posterior STG) is language comprehension, not social perception. The social function of STG is in STS/mid-STG (SuperiorTemporal, SuperiorTemporalSulcus)."
      }
    },
    "non_cortical_note": "25 nodes (14 subcortical + 11 brainstem) have all-zero W_sensory rows except Amygdala (olfactory, 2026-09-03 #108 Q2). Per runtime state model §4.1, only category=cortical nodes participate in WC dynamics and receive s(t); Amygdala pain/social processing still arrives through corticocortical connections.",
    "nodes_without_direct_sensory": "7 cortical nodes lack direct modality-specific s(t): CaudalMiddleFrontal (premotor), Entorhinal (MTL memory), IsthmusCingulate (RSC spatial), Parahippocampal (context), PosteriorCingulate (DMN hub), Precentral (M1 motor). They participate in WC dynamics through W·a and b_j inputs.",
