<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet 源配置（P4a 环境锁定）。

  为何需要它：此前 obj/*.nuget.g.props 里烘焙了开发机的本地包路径
  （/home/dog/game/.nuget-pkgs），干净检出无法复现 restore。
  本文件把包源显式声明，使干净检出 + 联网可 restore。

  本地离线：设置 NUGET_PACKAGES=<repo>/.nuget-pkgs 复用仓库内缓存。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
